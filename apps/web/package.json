{
  "name": "@oncue/web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm run db:migrate:local",
    "dev": "vite",
    "build": "vite build && node scripts/check-no-dev-inspect.mjs && node scripts/check-no-dev-harness.mjs && node scripts/check-no-secret-in-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:e2e": "node scripts/playwright.mjs",
    "test:perf": "ONCUE_PERF=1 node scripts/playwright.mjs --workers=1 e2e/perf.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@clerk/backend": "^3.17.1",
    "@clerk/react": "^6.15.0",
    "@oncue/bridge": "workspace:*",
    "@oncue/protocol": "workspace:*",
    "agents": "0.16.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.39.0",
    "nanoid": "^6.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.4",
    "react-router": "^8.3.1",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "3.6.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.54.3",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "29.1.1",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
